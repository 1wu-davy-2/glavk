# Upload this visible file to the server, rename it to .env, then edit CHANGE values.
# Compose reads this one root .env for the backend and frontend.
APP_ENV=production

FRONTEND_PORT=6222
BACKEND_PORT=6555

# Keep the backend local to the Docker host. The frontend nginx proxies /api internally.
BACKEND_BIND_ADDRESS=127.0.0.1

# ===== Database =====
# SQLite needs no setup: the whole database is a single file at /app/data/glavk.sqlite3
# living in the persistent backend_data volume. Leave this line alone.
# Keep the four slashes: "sqlite://" + the absolute path "/app/data/...".
# Three slashes would make it a relative path and the data would not survive a rebuild.
DATABASE_URL=sqlite:////app/data/glavk.sqlite3

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-admin-password
ADMIN_PASSWORD_HASH=
AUTH_TOKEN_TTL_DAYS=30

# Leave the encryption keys empty. The backend generates them once and stores them
# in the persistent backend_data volume on first startup.
AUTH_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
TRANSPORT_PRIVATE_KEY_B64=
GLAVK_RUNTIME_SECRETS_FILE=/app/data/runtime-secrets.env

# Same-origin frontend requests do not require CORS.
CORS_ORIGINS=
SCREENSHOT_DIR=/app/data/screenshots
SCREENSHOT_ALLOW_PRIVATE_NETWORKS=false

# Browsers only expose WebCrypto (crypto.subtle) on HTTPS, localhost or 127.0.0.1.
# On a plain-HTTP origin the login page cannot encrypt credentials at all, so set this
# to true to let the frontend send them in cleartext and keep the app usable.
# Only do this for a self-hosted instance on a trusted network; leave it false (default)
# when the site is reachable over HTTPS.
ALLOW_PLAINTEXT_CREDENTIALS=false
